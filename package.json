{
  "name": "saathi-safety-prototype",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "setup": "npm install && npm --prefix communication-server install && npm --prefix mother-client install",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:all": "concurrently -k -n server,woman,mother -c yellow,magenta,cyan \"npm:server\" \"npm:dev\" \"npm:mother\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm --prefix communication-server run dev",
    "mother": "npm --prefix mother-client run dev",
    "test": "node --test"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
